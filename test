--[[
    HubUI v3 - Roblox GUI library
    Layout: Header (drag/close/minimize) + left Sidebar navigation (Tabs) + Content pages.
    Each Tab holds Sections (cards); each Section holds Toggle/Dropdown/MultiDropdown/Slider.
    Includes live theme customization and auto-destroy on re-execute.

    Design notes (why this looks better than a flat list of rows):
    - Real color hierarchy: sidebar/header/cards/rows are each a distinct shade,
      not one flat gray, so the eye can parse structure at a glance.
    - Sidebar + active-tab indicator instead of one long vertical dump of controls.
    - Consistent 8px spacing scale, larger corner radii, thin low-contrast strokes
      instead of hard borders.
    - Small motion on the things that deserve it (tab switch, toggle knob, window
      entrance) using TweenService — cheap, one-shot, event-driven, not per-frame.

    Performance notes:
    - No RunService/per-frame polling loops anywhere.
    - Theme changes update existing instances in place via a registry, no rebuilding.
    - Tabs are pre-built once; switching just flips .Visible, nothing is recreated.

    USAGE:
    local Hub = loadstring(game:HttpGet("..."))()
    local Window = Hub:CreateWindow("My Hub")

    local Combat = Window:CreateTab("Combat")
    local General = Combat:CreateSection("General")
    General:CreateToggle("Auto Parry", false, function(state) end)
    General:CreateSlider("Reach", 0, 50, 10, function(v) end)

    -- quick elements without making a tab go in an auto "Home" tab/"General" section:
    Window:CreateToggle("Quick Toggle", false, function(state) end)

    -- built-in color customization tab:
    Window:CreateSettingsTab("Settings")
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

----------------------------------------------------------------
-- Destroy any previous instance of this UI before creating a new one
----------------------------------------------------------------
local GUI_NAME = "HubUI"

local existing = PlayerGui:FindFirstChild(GUI_NAME)
if existing then
    existing:Destroy()
end

----------------------------------------------------------------
-- Theme (mutable at runtime via the registry below)
----------------------------------------------------------------
local Theme = {
    Background = Color3.fromRGB(17, 17, 21),
    Sidebar = Color3.fromRGB(12, 12, 15),
    Panel = Color3.fromRGB(25, 25, 31),
    Section = Color3.fromRGB(21, 21, 26),
    Accent = Color3.fromRGB(99, 102, 241),
    Text = Color3.fromRGB(240, 240, 245),
    SubText = Color3.fromRGB(142, 142, 153),
    Stroke = Color3.fromRGB(38, 38, 46),
    Font = Enum.Font.Gotham,
    FontBold = Enum.Font.GothamBold,
}

-- {Instance, Property, Key, Guard?} entries; updated in place when a theme color changes.
local Registry = {}

local function Themed(inst, property, key, guard)
    table.insert(Registry, { Instance = inst, Property = property, Key = key, Guard = guard })
    inst[property] = Theme[key]
    return inst
end

local function ApplyTheme(key, color)
    Theme[key] = color
    for _, entry in ipairs(Registry) do
        if entry.Key == key and entry.Instance and entry.Instance.Parent then
            if (not entry.Guard) or entry.Guard() then
                entry.Instance[entry.Property] = color
            end
        end
    end
end

----------------------------------------------------------------
-- Helpers
----------------------------------------------------------------
local function new(class, props, children)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        inst[k] = v
    end
    for _, child in ipairs(children or {}) do
        child.Parent = inst
    end
    return inst
end

local function corner(radius)
    return new("UICorner", { CornerRadius = UDim.new(0, radius or 8) })
end

local function strokeInst(thickness)
    local s = new("UIStroke", { Thickness = thickness or 1, Transparency = 0.5 })
    Themed(s, "Color", "Stroke")
    return s
end

local function tween(inst, props, time, style, dir)
    TweenService:Create(
        inst,
        TweenInfo.new(time or 0.16, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
        props
    ):Play()
end

local function lighten(color, amt)
    local h, s, v = color:ToHSV()
    return Color3.fromHSV(h, s, math.clamp(v + amt, 0, 1))
end

local function hoverize(button, key)
    button.MouseEnter:Connect(function()
        tween(button, { BackgroundColor3 = lighten(Theme[key], 0.06) }, 0.12)
    end)
    button.MouseLeave:Connect(function()
        tween(button, { BackgroundColor3 = Theme[key] }, 0.12)
    end)
end

local function hexToColor3(hex)
    hex = hex:gsub("#", ""):gsub("%s", "")
    if #hex ~= 6 then
        return nil
    end
    local r = tonumber(hex:sub(1, 2), 16)
    local g = tonumber(hex:sub(3, 4), 16)
    local b = tonumber(hex:sub(5, 6), 16)
    if not (r and g and b) then
        return nil
    end
    return Color3.fromRGB(r, g, b)
end

local function nextOrder(obj)
    obj._order = obj._order + 1
    return obj._order
end

----------------------------------------------------------------
-- Metatables
----------------------------------------------------------------
local Hub = {}
Hub.__index = Hub

local Tab = {}
Tab.__index = Tab

local Section = {}
Section.__index = Section

----------------------------------------------------------------
-- Window
----------------------------------------------------------------
local WINDOW_W, WINDOW_H = 600, 380
local SIDEBAR_W = 140
local HEADER_H = 44

function Hub:CreateWindow(title)
    local ScreenGui = new("ScreenGui", {
        Name = GUI_NAME,
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = PlayerGui,
    })

    local Main = new("Frame", {
        Name = "Main",
        Size = UDim2.new(0, math.floor(WINDOW_W * 0.9), 0, math.floor(WINDOW_H * 0.9)),
        Position = UDim2.new(0.5, -WINDOW_W / 2, 0.5, -WINDOW_H / 2),
        BackgroundColor3 = Theme.Background,
        ClipsDescendants = true,
        Parent = ScreenGui,
    }, { corner(16), strokeInst(1) })
    Themed(Main, "BackgroundColor3", "Background")

    ----------------------------------------------------------------
    -- Header
    ----------------------------------------------------------------
    local Header = new("Frame", {
        Name = "Header",
        Size = UDim2.new(1, 0, 0, HEADER_H),
        BackgroundColor3 = Theme.Panel,
        Parent = Main,
    })
    Themed(Header, "BackgroundColor3", "Panel")

    local AccentBar = new("Frame", {
        Size = UDim2.new(1, 0, 0, 2),
        Position = UDim2.new(0, 0, 1, 0),
        BorderSizePixel = 0,
        BackgroundColor3 = Theme.Accent,
        Parent = Header,
    })
    Themed(AccentBar, "BackgroundColor3", "Accent")

    new("TextLabel", {
        Text = title or "Hub",
        Font = Theme.FontBold,
        TextSize = 17,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -100, 1, 0),
        Position = UDim2.new(0, 16, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = Theme.Text,
        Parent = Header,
    })
    -- (kept unthemed-reference-free on purpose: fetched via Header:FindFirstChildOfClass below is avoided;
    -- title color is registered directly)
    local TitleLabel = Header:GetChildren()[#Header:GetChildren()]
    Themed(TitleLabel, "TextColor3", "Text")

    local CloseBtn = new("TextButton", {
        Text = "x",
        Font = Theme.FontBold,
        TextSize = 15,
        Size = UDim2.new(0, 26, 0, 26),
        Position = UDim2.new(1, -34, 0.5, -13),
        BackgroundColor3 = Theme.Section,
        Parent = Header,
    }, { corner(8) })
    Themed(CloseBtn, "BackgroundColor3", "Section")
    Themed(CloseBtn, "TextColor3", "Text")
    hoverize(CloseBtn, "Section")

    local MinBtn = new("TextButton", {
        Text = "_",
        Font = Theme.FontBold,
        TextSize = 15,
        Size = UDim2.new(0, 26, 0, 26),
        Position = UDim2.new(1, -64, 0.5, -13),
        BackgroundColor3 = Theme.Section,
        Parent = Header,
    }, { corner(8) })
    Themed(MinBtn, "BackgroundColor3", "Section")
    Themed(MinBtn, "TextColor3", "Text")
    hoverize(MinBtn, "Section")

    ----------------------------------------------------------------
    -- Sidebar
    ----------------------------------------------------------------
    local Sidebar = new("Frame", {
        Name = "Sidebar",
        Size = UDim2.new(0, SIDEBAR_W, 1, -HEADER_H),
        Position = UDim2.new(0, 0, 0, HEADER_H),
        BackgroundColor3 = Theme.Sidebar,
        Parent = Main,
    })
    Themed(Sidebar, "BackgroundColor3", "Sidebar")

    new("Frame", { -- vertical divider between sidebar and content
        Size = UDim2.new(0, 1, 1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        BorderSizePixel = 0,
        BackgroundColor3 = Theme.Stroke,
        Parent = Sidebar,
    })

    local TabList = new("Frame", {
        Size = UDim2.new(1, -16, 1, -16),
        Position = UDim2.new(0, 8, 0, 8),
        BackgroundTransparency = 1,
        Parent = Sidebar,
    })
    new("UIListLayout", {
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = TabList,
    })

    ----------------------------------------------------------------
    -- Content / pages
    ----------------------------------------------------------------
    local Pages = new("Frame", {
        Name = "Pages",
        Size = UDim2.new(1, -SIDEBAR_W, 1, -HEADER_H),
        Position = UDim2.new(0, SIDEBAR_W, 0, HEADER_H),
        BackgroundTransparency = 1,
        Parent = Main,
    })

    ----------------------------------------------------------------
    -- Drag support (Header only)
    ----------------------------------------------------------------
    do
        local dragging, dragStart, startPos = false, nil, nil
        Header.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = Main.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                Main.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end)
    end

    local minimized = false
    MinBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        Sidebar.Visible = not minimized
        Pages.Visible = not minimized
        tween(Main, {
            Size = minimized
                and UDim2.new(0, WINDOW_W, 0, HEADER_H)
                or UDim2.new(0, WINDOW_W, 0, WINDOW_H),
        }, 0.2)
    end)

    CloseBtn.MouseButton1Click:Connect(function()
        ScreenGui.Enabled = false
    end)

    local Window = setmetatable({
        ScreenGui = ScreenGui,
        Main = Main,
        Sidebar = TabList,
        Pages = Pages,
        _order = 0,
        _tabs = {},
    }, Hub)

    -- entrance "pop" animation
    tween(Main, {
        Size = UDim2.new(0, WINDOW_W, 0, WINDOW_H),
    }, 0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

    return Window
end

----------------------------------------------------------------
-- Tabs
----------------------------------------------------------------
function Hub:CreateTab(name)
    local Button = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = Theme.Accent,
        BackgroundTransparency = 1,
        Text = "",
        LayoutOrder = nextOrder(self),
        Parent = self.Sidebar,
    }, { corner(8) })

    local Label = new("TextLabel", {
        Text = name or "Tab",
        Font = Theme.Font,
        TextSize = 13,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -16, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = Theme.SubText,
        Parent = Button,
    })

    local Indicator = new("Frame", {
        Size = UDim2.new(0, 0, 0, 16),
        Position = UDim2.new(0, 0, 0.5, -8),
        BackgroundColor3 = Theme.Accent,
        Visible = false,
        Parent = Button,
    }, { corner(2) })
    Themed(Indicator, "BackgroundColor3", "Accent")

    local Page = new("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 3,
        Visible = false,
        Parent = self.Pages,
    })
    Themed(Page, "ScrollBarImageColor3", "Accent")

    new("UIPadding", {
        PaddingTop = UDim.new(0, 14),
        PaddingBottom = UDim.new(0, 14),
        PaddingLeft = UDim.new(0, 14),
        PaddingRight = UDim.new(0, 14),
        Parent = Page,
    })
    new("UIListLayout", {
        Padding = UDim.new(0, 10),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = Page,
    })

    local active = false

    Themed(Button, "BackgroundColor3", "Accent", function() return active end)

    local function setActive(isActive)
        active = isActive
        Page.Visible = isActive
        Indicator.Visible = isActive
        tween(Button, { BackgroundTransparency = isActive and 0.85 or 1 }, 0.15)
        tween(Label, { TextColor3 = isActive and Theme.Text or Theme.SubText }, 0.15)
        tween(Indicator, { Size = isActive and UDim2.new(0, 3, 0, 16) or UDim2.new(0, 0, 0, 16) }, 0.15)
    end

    Button.MouseEnter:Connect(function()
        if not active then
            tween(Button, { BackgroundTransparency = 0.93 }, 0.12)
        end
    end)
    Button.MouseLeave:Connect(function()
        if not active then
            tween(Button, { BackgroundTransparency = 1 }, 0.12)
        end
    end)

    Button.MouseButton1Click:Connect(function()
        for _, t in ipairs(self._tabs) do
            t.setActive(false)
        end
        setActive(true)
    end)

    table.insert(self._tabs, { setActive = setActive })

    if #self._tabs == 1 then
        setActive(true)
    end

    return setmetatable({ Page = Page, _order = 0 }, Tab)
end

function Hub:_getDefaultTab()
    if not self._defaultTab then
        self._defaultTab = self:CreateTab("Home")
    end
    return self._defaultTab
end

function Hub:_getDefaultSection()
    if not self._default then
        self._default = self:_getDefaultTab():CreateSection("General")
    end
    return self._default
end

-- convenience: build straight on the window -> lands in an auto "Home" tab
function Hub:CreateSection(title)
    return self:_getDefaultTab():CreateSection(title)
end
function Hub:CreateToggle(...)
    return self:_getDefaultSection():CreateToggle(...)
end
function Hub:CreateDropdown(...)
    return self:_getDefaultSection():CreateDropdown(...)
end
function Hub:CreateMultiDropdown(...)
    return self:_getDefaultSection():CreateMultiDropdown(...)
end
function Hub:CreateSlider(...)
    return self:_getDefaultSection():CreateSlider(...)
end

----------------------------------------------------------------
-- Section
----------------------------------------------------------------
function Tab:CreateSection(title)
    local SectionFrame = new("Frame", {
        BackgroundColor3 = Theme.Section,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = nextOrder(self),
        Parent = self.Page,
    }, { corner(12), strokeInst(1) })
    Themed(SectionFrame, "BackgroundColor3", "Section")

    new("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = SectionFrame,
    })
    new("UIPadding", {
        PaddingTop = UDim.new(0, 12),
        PaddingBottom = UDim.new(0, 12),
        PaddingLeft = UDim.new(0, 12),
        PaddingRight = UDim.new(0, 12),
        Parent = SectionFrame,
    })

    local TitleLabel = new("TextLabel", {
        Text = title or "Section",
        Font = Theme.FontBold,
        TextSize = 13,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 18),
        TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = 0,
        Parent = SectionFrame,
    })
    Themed(TitleLabel, "TextColor3", "SubText")

    local Inner = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = 1,
        Parent = SectionFrame,
    })
    new("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = Inner,
    })

    return setmetatable({ Inner = Inner, _order = 0 }, Section)
end

----------------------------------------------------------------
-- Toggle
----------------------------------------------------------------
function Section:CreateToggle(text, default, callback)
    default = default or false
    callback = callback or function() end

    local Holder = new("Frame", {
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundTransparency = 1,
        LayoutOrder = nextOrder(self),
        Parent = self.Inner,
    })

    local Label = new("TextLabel", {
        Text = text,
        Font = Theme.Font,
        TextSize = 13,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -56, 1, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Holder,
    })
    Themed(Label, "TextColor3", "Text")

    local Switch = new("Frame", {
        Size = UDim2.new(0, 38, 0, 20),
        Position = UDim2.new(1, -38, 0.5, -10),
        BackgroundColor3 = default and Theme.Accent or Theme.Stroke,
        Parent = Holder,
    }, { corner(10) })

    local Knob = new("Frame", {
        Size = UDim2.new(0, 16, 0, 16),
        Position = default and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        Parent = Switch,
    }, { corner(8) })

    local Button = new("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        Parent = Holder,
    })

    local state = default
    local api = {}

    local function set(value)
        state = value
        tween(Switch, { BackgroundColor3 = state and Theme.Accent or Theme.Stroke }, 0.15)
        tween(
            Knob,
            { Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8) },
            0.2,
            Enum.EasingStyle.Back
        )
        callback(state)
    end

    Themed(Switch, "BackgroundColor3", "Accent", function() return state end)

    Button.MouseButton1Click:Connect(function()
        set(not state)
    end)

    function api:Set(value) set(value) end
    function api:Get() return state end

    return api
end

----------------------------------------------------------------
-- Dropdown (single select)
----------------------------------------------------------------
function Section:CreateDropdown(text, options, default, callback)
    options = options or {}
    callback = callback or function() end

    local Holder = new("Frame", {
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = Theme.Panel,
        ClipsDescendants = true,
        LayoutOrder = nextOrder(self),
        Parent = self.Inner,
    }, { corner(8) })
    Themed(Holder, "BackgroundColor3", "Panel")

    local DropLabel = new("TextLabel", {
        Text = text,
        Font = Theme.Font,
        TextSize = 13,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -90, 0, 32),
        Position = UDim2.new(0, 10, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Holder,
    })
    Themed(DropLabel, "TextColor3", "Text")

    local SelectedLabel = new("TextLabel", {
        Text = default or "Select...",
        Font = Theme.Font,
        TextSize = 12,
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 80, 0, 32),
        Position = UDim2.new(1, -96, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Right,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = Holder,
    })
    Themed(SelectedLabel, "TextColor3", "SubText")

    local ToggleButton = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundTransparency = 1,
        Text = "",
        Parent = Holder,
    })

    local List = new("Frame", {
        Position = UDim2.new(0, 8, 0, 34),
        Size = UDim2.new(1, -16, 0, #options * 26 + math.max(#options - 1, 0) * 4),
        BackgroundTransparency = 1,
        Parent = Holder,
    })
    new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = List })

    local open = false
    local selected = default

    local function refreshHeight()
        local listH = #options * 26 + math.max(#options - 1, 0) * 4
        Holder.Size = UDim2.new(1, 0, 0, open and (34 + listH + 8) or 32)
    end

    for i, option in ipairs(options) do
        local OptButton = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 26),
            BackgroundColor3 = Theme.Section,
            Text = option,
            Font = Theme.Font,
            TextSize = 12,
            LayoutOrder = i,
            Parent = List,
        }, { corner(6) })
        Themed(OptButton, "BackgroundColor3", "Section")
        Themed(OptButton, "TextColor3", "Text")
        hoverize(OptButton, "Section")

        OptButton.MouseButton1Click:Connect(function()
            selected = option
            SelectedLabel.Text = option
            callback(option)
            open = false
            refreshHeight()
        end)
    end

    ToggleButton.MouseButton1Click:Connect(function()
        open = not open
        refreshHeight()
    end)

    local api = {}
    function api:Get() return selected end
    function api:Set(option)
        selected = option
        SelectedLabel.Text = option
        callback(option)
    end

    if default then
        callback(default)
    end

    return api
end

----------------------------------------------------------------
-- MultiDropdown (multi select)
----------------------------------------------------------------
function Section:CreateMultiDropdown(text, options, defaults, callback)
    options = options or {}
    defaults = defaults or {}
    callback = callback or function() end

    local selectedSet = {}
    for _, v in ipairs(defaults) do
        selectedSet[v] = true
    end

    local Holder = new("Frame", {
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = Theme.Panel,
        ClipsDescendants = true,
        LayoutOrder = nextOrder(self),
        Parent = self.Inner,
    }, { corner(8) })
    Themed(Holder, "BackgroundColor3", "Panel")

    local Label = new("TextLabel", {
        Text = text,
        Font = Theme.Font,
        TextSize = 13,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -100, 0, 32),
        Position = UDim2.new(0, 10, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Holder,
    })
    Themed(Label, "TextColor3", "Text")

    local SelectedLabel = new("TextLabel", {
        Text = (#defaults > 0) and table.concat(defaults, ", ") or "None",
        Font = Theme.Font,
        TextSize = 11,
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 96, 0, 32),
        Position = UDim2.new(1, -106, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Right,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = Holder,
    })
    Themed(SelectedLabel, "TextColor3", "SubText")

    local ToggleButton = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundTransparency = 1,
        Text = "",
        Parent = Holder,
    })

    local List = new("Frame", {
        Position = UDim2.new(0, 8, 0, 34),
        Size = UDim2.new(1, -16, 0, #options * 26 + math.max(#options - 1, 0) * 4),
        BackgroundTransparency = 1,
        Parent = Holder,
    })
    new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = List })

    local open = false

    local function refreshHeight()
        local listH = #options * 26 + math.max(#options - 1, 0) * 4
        Holder.Size = UDim2.new(1, 0, 0, open and (34 + listH + 8) or 32)
    end

    local function refreshSelectedLabel()
        local list = {}
        for _, opt in ipairs(options) do
            if selectedSet[opt] then table.insert(list, opt) end
        end
        SelectedLabel.Text = (#list > 0) and table.concat(list, ", ") or "None"
        callback(list)
    end

    for i, option in ipairs(options) do
        local OptButton = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 26),
            BackgroundColor3 = selectedSet[option] and Theme.Accent or Theme.Section,
            Text = option,
            Font = Theme.Font,
            TextSize = 12,
            LayoutOrder = i,
            Parent = List,
        }, { corner(6) })
        Themed(OptButton, "TextColor3", "Text")
        Themed(OptButton, "BackgroundColor3", "Accent", function() return selectedSet[option] end)
        Themed(OptButton, "BackgroundColor3", "Section", function() return not selectedSet[option] end)

        OptButton.MouseButton1Click:Connect(function()
            selectedSet[option] = not selectedSet[option]
            tween(OptButton, { BackgroundColor3 = selectedSet[option] and Theme.Accent or Theme.Section }, 0.12)
            refreshSelectedLabel()
        end)
    end

    ToggleButton.MouseButton1Click:Connect(function()
        open = not open
        refreshHeight()
    end)

    local api = {}
    function api:Get()
        local list = {}
        for _, opt in ipairs(options) do
            if selectedSet[opt] then table.insert(list, opt) end
        end
        return list
    end

    if #defaults > 0 then
        callback(defaults)
    end

    return api
end

