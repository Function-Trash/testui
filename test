-- Slider (with linked textbox)
----------------------------------------------------------------
function Section:CreateSlider(text, min, max, default, callback)
    min = min or 0
    max = max or 100
    default = math.clamp(default or min, min, max)
    callback = callback or function() end

    local Holder = new("Frame", {
        Size = UDim2.new(1, 0, 0, 50),
        BackgroundColor3 = Theme.Panel,
        LayoutOrder = nextOrder(self),
        Parent = self.Inner,
    }, { corner(8) })
    Themed(Holder, "BackgroundColor3", "Panel")

    local Label = new("TextLabel", {
        Text = text,
        Font = Theme.Font,
        TextSize = 13,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -70, 0, 22),
        Position = UDim2.new(0, 10, 0, 4),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Holder,
    })
    Themed(Label, "TextColor3", "Text")

    local ValueBox = new("TextBox", {
        Text = tostring(default),
        Font = Theme.Font,
        TextSize = 12,
        BackgroundColor3 = Theme.Section,
        Size = UDim2.new(0, 52, 0, 20),
        Position = UDim2.new(1, -62, 0, 5),
        ClearTextOnFocus = false,
        Parent = Holder,
    }, { corner(6) })
    Themed(ValueBox, "BackgroundColor3", "Section")
    Themed(ValueBox, "TextColor3", "Text")

    local Track = new("Frame", {
        Size = UDim2.new(1, -20, 0, 5),
        Position = UDim2.new(0, 10, 0, 34),
        BackgroundColor3 = Theme.Stroke,
        Parent = Holder,
    }, { corner(3) })
    Themed(Track, "BackgroundColor3", "Stroke")

    local Fill = new("Frame", {
        Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = Theme.Accent,
        Parent = Track,
    }, { corner(3) })
    Themed(Fill, "BackgroundColor3", "Accent")

    local Knob = new("Frame", {
        Size = UDim2.new(0, 12, 0, 12),
        Position = UDim2.new((default - min) / (max - min), -6, 0.5, -6),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        ZIndex = 2,
        Parent = Track,
    }, { corner(6) })

    local value = default
    local dragging = false

    local function setValue(v, fromTextbox)
        v = math.clamp(v, min, max)
        v = math.floor(v + 0.5)
        value = v
        local alpha = (max > min) and (v - min) / (max - min) or 0
        Fill.Size = UDim2.new(alpha, 0, 1, 0)
        Knob.Position = UDim2.new(alpha, -6, 0.5, -6)
        if not fromTextbox then
            ValueBox.Text = tostring(v)
        end
        callback(v)
    end

    local function updateFromX(xPos)
        local rel = math.clamp((xPos - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
        setValue(min + rel * (max - min))
    end

    Track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            tween(Knob, { Size = UDim2.new(0, 14, 0, 14) }, 0.1)
            updateFromX(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromX(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                tween(Knob, { Size = UDim2.new(0, 12, 0, 12) }, 0.1)
            end
            dragging = false
        end
    end)

    ValueBox.FocusLost:Connect(function()
        local num = tonumber(ValueBox.Text)
        if num then
            setValue(num, true)
        end
        ValueBox.Text = tostring(value)
    end)

    local api = {}
    function api:Set(v) setValue(v) end
    function api:Get() return value end

    return api
end

----------------------------------------------------------------
-- Built-in color settings tab
----------------------------------------------------------------
local PRESETS = {
    Color3.fromRGB(99, 102, 241),  -- indigo
    Color3.fromRGB(160, 90, 255),  -- purple
    Color3.fromRGB(255, 90, 130),  -- pink
    Color3.fromRGB(255, 110, 80),  -- orange
    Color3.fromRGB(80, 200, 140),  -- green
    Color3.fromRGB(80, 200, 230),  -- cyan
    Color3.fromRGB(235, 220, 90),  -- yellow
    Color3.fromRGB(230, 90, 90),   -- red
}

function Hub:CreateSettingsTab(name)
    local tab = self:CreateTab(name or "Settings")
    local sect = tab:CreateSection("Theme")

    local targetKeys = { "Accent", "Background", "Sidebar", "Panel", "Section" }
    local target = "Accent"

    sect:CreateDropdown("Customize", targetKeys, "Accent", function(choice)
        target = choice
    end)

    local Row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundTransparency = 1,
        LayoutOrder = nextOrder(sect),
        Parent = sect.Inner,
    })
    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = Row,
    })

    for _, color in ipairs(PRESETS) do
        local Swatch = new("TextButton", {
            Size = UDim2.new(0, 26, 0, 26),
            BackgroundColor3 = color,
            Text = "",
            Parent = Row,
        }, { corner(6) })
        Swatch.MouseButton1Click:Connect(function()
            ApplyTheme(target, color)
        end)
    end

    local HexRow = new("Frame", {
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundTransparency = 1,
        LayoutOrder = nextOrder(sect),
        Parent = sect.Inner,
    })

    local HexBox = new("TextBox", {
        PlaceholderText = "Hex e.g. 6366F1",
        Text = "",
        Font = Theme.Font,
        TextSize = 12,
        BackgroundColor3 = Theme.Panel,
        Size = UDim2.new(1, -70, 1, 0),
        ClearTextOnFocus = false,
        Parent = HexRow,
    }, { corner(6) })
    Themed(HexBox, "BackgroundColor3", "Panel")
    Themed(HexBox, "TextColor3", "Text")

    local ApplyBtn = new("TextButton", {
        Text = "Apply",
        Font = Theme.FontBold,
        TextSize = 12,
        BackgroundColor3 = Theme.Accent,
        Size = UDim2.new(0, 60, 1, 0),
        Position = UDim2.new(1, -60, 0, 0),
        Parent = HexRow,
    }, { corner(6) })
    Themed(ApplyBtn, "BackgroundColor3", "Accent")

    ApplyBtn.MouseButton1Click:Connect(function()
        local color = hexToColor3(HexBox.Text)
        if color then
            ApplyTheme(target, color)
        end
    end)

    return tab
end

-- backwards-compatible alias
Hub.CreateColorSettingsSection = Hub.CreateSettingsTab

return Hub
