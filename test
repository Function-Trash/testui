-- Library
----------------------------------------------------------------
local Hub = {}
Hub.__index = Hub

local Section = {}
Section.__index = Section

----------------------------------------------------------------
-- Window
----------------------------------------------------------------
function Hub:CreateWindow(title)
    local ScreenGui = new("ScreenGui", {
        Name = GUI_NAME,
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = PlayerGui,
    })

    local Main = new("Frame", {
        Name = "Main",
        Size = UDim2.new(0, 380, 0, 480),
        Position = UDim2.new(0.5, -190, 0.5, -240),
        BackgroundColor3 = Theme.Background,
        ClipsDescendants = true,
        Parent = ScreenGui,
    }, { corner(12), strokeInst(1) })
    Themed(Main, "BackgroundColor3", "Background")

    local TopBar = new("Frame", {
        Name = "TopBar",
        Size = UDim2.new(1, 0, 0, 42),
        BackgroundColor3 = Theme.Panel,
        Parent = Main,
    }, { corner(12) })
    Themed(TopBar, "BackgroundColor3", "Panel")

    local TopBarMask = new("Frame", { -- square off the bottom corners of the topbar
        Size = UDim2.new(1, 0, 0, 12),
        Position = UDim2.new(0, 0, 1, -12),
        BackgroundColor3 = Theme.Panel,
        BorderSizePixel = 0,
        Parent = TopBar,
    })
    Themed(TopBarMask, "BackgroundColor3", "Panel")

    local AccentBar = new("Frame", {
        Size = UDim2.new(1, 0, 0, 2),
        Position = UDim2.new(0, 0, 1, 0),
        BorderSizePixel = 0,
        BackgroundColor3 = Theme.Accent,
        Parent = TopBar,
    })
    Themed(AccentBar, "BackgroundColor3", "Accent")

    local TitleLabel = new("TextLabel", {
        Text = title or "Hub",
        Font = Theme.FontBold,
        TextSize = 16,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -90, 1, 0),
        Position = UDim2.new(0, 14, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = TopBar,
    })
    Themed(TitleLabel, "TextColor3", "Text")

    -- minimize + close buttons
    local CloseBtn = new("TextButton", {
        Text = "x",
        Font = Theme.FontBold,
        TextSize = 15,
        Size = UDim2.new(0, 26, 0, 26),
        Position = UDim2.new(1, -34, 0.5, -13),
        BackgroundColor3 = Theme.Section,
        Parent = TopBar,
    }, { corner(7) })
    Themed(CloseBtn, "BackgroundColor3", "Section")
    Themed(CloseBtn, "TextColor3", "Text")
    hoverize(CloseBtn, "Section")

    local MinBtn = new("TextButton", {
        Text = "_",
        Font = Theme.FontBold,
        TextSize = 15,
        Size = UDim2.new(0, 26, 0, 26),
        Position = UDim2.new(1, -64, 0.5, -13),
        BackgroundColor3 = Theme.Section,
        Parent = TopBar,
    }, { corner(7) })
    Themed(MinBtn, "BackgroundColor3", "Section")
    Themed(MinBtn, "TextColor3", "Text")
    hoverize(MinBtn, "Section")

    local Body = new("ScrollingFrame", {
        Name = "Body",
        Size = UDim2.new(1, -20, 1, -54),
        Position = UDim2.new(0, 10, 0, 48),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 3,
        Parent = Main,
    })
    Themed(Body, "ScrollBarImageColor3", "Accent")

    new("UIListLayout", {
        Padding = UDim.new(0, 10),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = Body,
    })

    -- drag support (TopBar only, so it never fights with scrolling/sliders)
    do
        local dragging, dragStart, startPos = false, nil, nil
        TopBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = Main.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                Main.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end)
    end

    local minimized = false
    MinBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        Body.Visible = not minimized
        tween(Main, { Size = minimized and UDim2.new(0, 380, 0, 42) or UDim2.new(0, 380, 0, 480) }, 0.2)
    end)

    CloseBtn.MouseButton1Click:Connect(function()
        ScreenGui.Enabled = false
    end)

    local Window = setmetatable({
        ScreenGui = ScreenGui,
        Main = Main,
        Body = Body,
        _order = 0,
    }, Hub)

    return Window
end

----------------------------------------------------------------
-- Section
----------------------------------------------------------------
local function nextOrder(obj)
    obj._order = obj._order + 1
    return obj._order
end

function Hub:CreateSection(title)
    local SectionFrame = new("Frame", {
        BackgroundColor3 = Theme.Section,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = nextOrder(self),
        Parent = self.Body,
    }, { corner(10), strokeInst(1) })
    Themed(SectionFrame, "BackgroundColor3", "Section")

    new("UIListLayout", {
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = SectionFrame,
    })
    new("UIPadding", {
        PaddingTop = UDim.new(0, 10),
        PaddingBottom = UDim.new(0, 10),
        PaddingLeft = UDim.new(0, 10),
        PaddingRight = UDim.new(0, 10),
        Parent = SectionFrame,
    })

    local TitleLabel = new("TextLabel", {
        Text = title or "Section",
        Font = Theme.FontBold,
        TextSize = 13,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 18),
        TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = 0,
        Parent = SectionFrame,
    })
    Themed(TitleLabel, "TextColor3", "SubText")

    local Inner = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = 1,
        Parent = SectionFrame,
    })
    new("UIListLayout", {
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = Inner,
    })

    return setmetatable({ Inner = Inner, _order = 0 }, Section)
end

function Hub:_getDefault()
    if not self._default then
        self._default = self:CreateSection("General")
    end
    return self._default
end

-- convenience: elements created directly on the window go in a "General" section
function Hub:CreateToggle(...)
    return self:_getDefault():CreateToggle(...)
end
function Hub:CreateDropdown(...)
    return self:_getDefault():CreateDropdown(...)
end
function Hub:CreateMultiDropdown(...)
    return self:_getDefault():CreateMultiDropdown(...)
end
function Hub:CreateSlider(...)
    return self:_getDefault():CreateSlider(...)
end

----------------------------------------------------------------
-- Toggle
----------------------------------------------------------------
function Section:CreateToggle(text, default, callback)
    default = default or false
    callback = callback or function() end

    local Holder = new("Frame", {
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundTransparency = 1,
        LayoutOrder = nextOrder(self),
        Parent = self.Inner,
    })

    local Label = new("TextLabel", {
        Text = text,
        Font = Theme.Font,
        TextSize = 13,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -56, 1, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Holder,
    })
    Themed(Label, "TextColor3", "Text")

    local Switch = new("Frame", {
        Size = UDim2.new(0, 38, 0, 20),
        Position = UDim2.new(1, -38, 0.5, -10),
        BackgroundColor3 = default and Theme.Accent or Theme.Stroke,
        Parent = Holder,
    }, { corner(10) })

    local Knob = new("Frame", {
        Size = UDim2.new(0, 16, 0, 16),
        Position = default and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        Parent = Switch,
    }, { corner(8) })

    local Button = new("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        Parent = Holder,
    })

    local state = default
    local api = {}

    local function set(value)
        state = value
        tween(Switch, { BackgroundColor3 = state and Theme.Accent or Theme.Stroke })
        tween(Knob, { Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8) })
        callback(state)
    end

    -- keep the accent-on state synced if the user changes the accent color later
    table.insert(Registry, {
        Instance = Switch,
        Property = "BackgroundColor3",
        Key = "Accent",
        Guard = function() return state end, -- only apply Accent while toggled on
    })

    Button.MouseButton1Click:Connect(function()
        set(not state)
    end)

    function api:Set(value) set(value) end
    function api:Get() return state end

    return api
end

----------------------------------------------------------------
-- Dropdown (single select)
----------------------------------------------------------------
function Section:CreateDropdown(text, options, default, callback)
    options = options or {}
    callback = callback or function() end

    local Holder = new("Frame", {
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = Theme.Panel,
        ClipsDescendants = true,
        LayoutOrder = nextOrder(self),
        Parent = self.Inner,
    }, { corner(7) })
    Themed(Holder, "BackgroundColor3", "Panel")

    local DropLabel = new("TextLabel", {
        Text = text,
        Font = Theme.Font,
        TextSize = 13,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -90, 0, 32),
        Position = UDim2.new(0, 10, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Holder,
    })
    Themed(DropLabel, "TextColor3", "Text")

    local SelectedLabel = new("TextLabel", {
        Text = default or "Select...",
        Font = Theme.Font,
        TextSize = 12,
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 80, 0, 32),
        Position = UDim2.new(1, -96, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Right,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = Holder,
    })
    Themed(SelectedLabel, "TextColor3", "SubText")

    local ToggleButton = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundTransparency = 1,
        Text = "",
        Parent = Holder,
    })

    local List = new("Frame", {
        Position = UDim2.new(0, 8, 0, 34),
        Size = UDim2.new(1, -16, 0, #options * 26 + math.max(#options - 1, 0) * 4),
        BackgroundTransparency = 1,
        Parent = Holder,
    })
    new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = List })

    local open = false
    local selected = default

    local function refreshHeight()
        local listH = #options * 26 + math.max(#options - 1, 0) * 4
        Holder.Size = UDim2.new(1, 0, 0, open and (34 + listH + 8) or 32)
    end

    for i, option in ipairs(options) do
        local OptButton = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 26),
            BackgroundColor3 = Theme.Section,
            Text = option,
            Font = Theme.Font,
            TextSize = 12,
            LayoutOrder = i,
            Parent = List,
        }, { corner(6) })
        Themed(OptButton, "BackgroundColor3", "Section")
        Themed(OptButton, "TextColor3", "Text")
        hoverize(OptButton, "Section")

        OptButton.MouseButton1Click:Connect(function()
            selected = option
            SelectedLabel.Text = option
            callback(option)
            open = false
            refreshHeight()
        end)
    end

    ToggleButton.MouseButton1Click:Connect(function()
        open = not open
        refreshHeight()
    end)

    local api = {}
    function api:Get() return selected end
    function api:Set(option)
        selected = option
        SelectedLabel.Text = option
        callback(option)
    end

    if default then
        callback(default)
    end

    return api
end

----------------------------------------------------------------
-- MultiDropdown (multi select)
----------------------------------------------------------------
function Section:CreateMultiDropdown(text, options, defaults, callback)
    options = options or {}
    defaults = defaults or {}
    callback = callback or function() end

    local selectedSet = {}
    for _, v in ipairs(defaults) do
        selectedSet[v] = true
    end

    local Holder = new("Frame", {
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = Theme.Panel,
        ClipsDescendants = true,
        LayoutOrder = nextOrder(self),
        Parent = self.Inner,
    }, { corner(7) })
    Themed(Holder, "BackgroundColor3", "Panel")

    local Label = new("TextLabel", {
        Text = text,
        Font = Theme.Font,
        TextSize = 13,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -100, 0, 32),
        Position = UDim2.new(0, 10, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Holder,
    })
    Themed(Label, "TextColor3", "Text")

    local SelectedLabel = new("TextLabel", {
        Text = (#defaults > 0) and table.concat(defaults, ", ") or "None",
        Font = Theme.Font,
        TextSize = 11,
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 96, 0, 32),
        Position = UDim2.new(1, -106, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Right,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = Holder,
    })
    Themed(SelectedLabel, "TextColor3", "SubText")

    local ToggleButton = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundTransparency = 1,
        Text = "",
        Parent = Holder,
    })

    local List = new("Frame", {
        Position = UDim2.new(0, 8, 0, 34),
        Size = UDim2.new(1, -16, 0, #options * 26 + math.max(#options - 1, 0) * 4),
        BackgroundTransparency = 1,
        Parent = Holder,
    })
    new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = List })

    local open = false

    local function refreshHeight()
        local listH = #options * 26 + math.max(#options - 1, 0) * 4
        Holder.Size = UDim2.new(1, 0, 0, open and (34 + listH + 8) or 32)
    end

    local function refreshSelectedLabel()
        local list = {}
        for _, opt in ipairs(options) do
            if selectedSet[opt] then table.insert(list, opt) end
        end
        SelectedLabel.Text = (#list > 0) and table.concat(list, ", ") or "None"
        callback(list)
    end

    for i, option in ipairs(options) do
        local OptButton = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 26),
            BackgroundColor3 = selectedSet[option] and Theme.Accent or Theme.Section,
            Text = option,
            Font = Theme.Font,
            TextSize = 12,
            LayoutOrder = i,
            Parent = List,
        }, { corner(6) })
        Themed(OptButton, "TextColor3", "Text")

        table.insert(Registry, {
            Instance = OptButton,
            Property = "BackgroundColor3",
            Key = "Accent",
            Guard = function() return selectedSet[option] end,
        })
        table.insert(Registry, {
            Instance = OptButton,
            Property = "BackgroundColor3",
            Key = "Section",
            Guard = function() return not selectedSet[option] end,
        })

        OptButton.MouseButton1Click:Connect(function()
            selectedSet[option] = not selectedSet[option]
            tween(OptButton, { BackgroundColor3 = selectedSet[option] and Theme.Accent or Theme.Section }, 0.12)
            refreshSelectedLabel()
        end)
    end

    ToggleButton.MouseButton1Click:Connect(function()
        open = not open
        refreshHeight()
    end)

    local api = {}
    function api:Get()
        local list = {}
        for _, opt in ipairs(options) do
            if selectedSet[opt] then table.insert(list, opt) end
        end
        return list
    end

    if #defaults > 0 then
        callback(defaults)
    end

    return api
end

----------------------------------------------------------------
-- Slider (with linked textbox)
----------------------------------------------------------------
function Section:CreateSlider(text, min, max, default, callback)
    min = min or 0
    max = max or 100
    default = math.clamp(default or min, min, max)
    callback = callback or function() end

    local Holder = new("Frame", {
        Size = UDim2.new(1, 0, 0, 50),
        BackgroundColor3 = Theme.Panel,
        LayoutOrder = nextOrder(self),
        Parent = self.Inner,
    }, { corner(7) })
    Themed(Holder, "BackgroundColor3", "Panel")

    local Label = new("TextLabel", {
        Text = text,
        Font = Theme.Font,
        TextSize = 13,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -70, 0, 22),
        Position = UDim2.new(0, 10, 0, 4),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Holder,
    })
    Themed(Label, "TextColor3", "Text")

    local ValueBox = new("TextBox", {
        Text = tostring(default),
        Font = Theme.Font,
        TextSize = 12,
        BackgroundColor3 = Theme.Section,
        Size = UDim2.new(0, 52, 0, 20),
        Position = UDim2.new(1, -62, 0, 5),
        ClearTextOnFocus = false,
        Parent = Holder,
    }, { corner(6) })
    Themed(ValueBox, "BackgroundColor3", "Section")
    Themed(ValueBox, "TextColor3", "Text")

    local Track = new("Frame", {
        Size = UDim2.new(1, -20, 0, 5),
        Position = UDim2.new(0, 10, 0, 34),
        BackgroundColor3 = Theme.Stroke,
        Parent = Holder,
    }, { corner(3) })
    Themed(Track, "BackgroundColor3", "Stroke")

    local Fill = new("Frame", {
        Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = Theme.Accent,
        Parent = Track,
    }, { corner(3) })
    Themed(Fill, "BackgroundColor3", "Accent")

    local Knob = new("Frame", {
        Size = UDim2.new(0, 12, 0, 12),
        Position = UDim2.new((default - min) / (max - min), -6, 0.5, -6),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        ZIndex = 2,
        Parent = Track,
    }, { corner(6) })

    local value = default
    local dragging = false

    local function setValue(v, fromTextbox)
        v = math.clamp(v, min, max)
        v = math.floor(v + 0.5)
        value = v
        local alpha = (max > min) and (v - min) / (max - min) or 0
        Fill.Size = UDim2.new(alpha, 0, 1, 0)
        Knob.Position = UDim2.new(alpha, -6, 0.5, -6)
        if not fromTextbox then
            ValueBox.Text = tostring(v)
        end
        callback(v)
    end

    local function updateFromX(xPos)
        local rel = math.clamp((xPos - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
        setValue(min + rel * (max - min))
    end

    Track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromX(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromX(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    ValueBox.FocusLost:Connect(function()
        local num = tonumber(ValueBox.Text)
        if num then
            setValue(num, true)
        end
        ValueBox.Text = tostring(value)
    end)

    local api = {}
    function api:Set(v) setValue(v) end
    function api:Get() return value end

    return api
end

----------------------------------------------------------------
-- Built-in color settings section
----------------------------------------------------------------
local PRESETS = {
    Color3.fromRGB(90, 120, 255),  -- blue
    Color3.fromRGB(160, 90, 255),  -- purple
    Color3.fromRGB(255, 90, 130),  -- pink
    Color3.fromRGB(255, 110, 80),  -- orange
    Color3.fromRGB(80, 200, 140),  -- green
    Color3.fromRGB(80, 200, 230),  -- cyan
    Color3.fromRGB(235, 220, 90),  -- yellow
    Color3.fromRGB(230, 90, 90),   -- red
}

function Hub:CreateColorSettingsSection(title)
    local sect = self:CreateSection(title or "Settings")

    local targetKeys = { "Accent", "Background", "Panel", "Section" }
    local target = "Accent"

    sect:CreateDropdown("Customize", targetKeys, "Accent", function(choice)
        target = choice
    end)

    -- swatch row
    local Row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundTransparency = 1,
        LayoutOrder = nextOrder(sect),
        Parent = sect.Inner,
    })
    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = Row,
    })

    for _, color in ipairs(PRESETS) do
        local Swatch = new("TextButton", {
            Size = UDim2.new(0, 26, 0, 26),
            BackgroundColor3 = color,
            Text = "",
            Parent = Row,
        }, { corner(6) })
        Swatch.MouseButton1Click:Connect(function()
            ApplyTheme(target, color)
        end)
    end

    -- hex input row
    local HexRow = new("Frame", {
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundTransparency = 1,
        LayoutOrder = nextOrder(sect),
        Parent = sect.Inner,
    })

    local HexBox = new("TextBox", {
        PlaceholderText = "Hex e.g. 5A78FF",
        Text = "",
        Font = Theme.Font,
        TextSize = 12,
        BackgroundColor3 = Theme.Panel,
        Size = UDim2.new(1, -70, 1, 0),
        ClearTextOnFocus = false,
        Parent = HexRow,
    }, { corner(6) })
    Themed(HexBox, "BackgroundColor3", "Panel")
    Themed(HexBox, "TextColor3", "Text")

    local ApplyBtn = new("TextButton", {
        Text = "Apply",
        Font = Theme.FontBold,
        TextSize = 12,
        BackgroundColor3 = Theme.Accent,
        Size = UDim2.new(0, 60, 1, 0),
        Position = UDim2.new(1, -60, 0, 0),
        Parent = HexRow,
    }, { corner(6) })
    Themed(ApplyBtn, "BackgroundColor3", "Accent")

    ApplyBtn.MouseButton1Click:Connect(function()
        local color = hexToColor3(HexBox.Text)
        if color then
            ApplyTheme(target, color)
        end
    end)

    return sect
end

return Hub
