--[[
    HubUI - simple Roblox GUI library
    Components: Toggle, Dropdown, MultiDropdown, Slider (with textbox)
    Auto-destroys any previous copy of itself when re-executed.

    USAGE (put in a LocalScript):

    local Hub = loadstring(game:HttpGet("...")) -- or require() if you use it as a module
    local Window = Hub:CreateWindow("My Hub")

    Window:CreateToggle("Enable Thing", false, function(state)
        print("Toggle:", state)
    end)

    Window:CreateDropdown("Pick One", {"Alpha","Beta","Gamma"}, "Alpha", function(choice)
        print("Selected:", choice)
    end)

    Window:CreateMultiDropdown("Pick Many", {"A","B","C","D"}, {"A"}, function(selected)
        print("Selected:", table.concat(selected, ", "))
    end)

    Window:CreateSlider("Speed", 0, 100, 16, function(value)
        print("Slider:", value)
    end)
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

----------------------------------------------------------------
-- Destroy any previous instance of this UI before creating a new one
----------------------------------------------------------------
local GUI_NAME = "HubUI"

local existing = PlayerGui:FindFirstChild(GUI_NAME)
if existing then
    existing:Destroy()
end

----------------------------------------------------------------
-- Theme
----------------------------------------------------------------
local Theme = {
    Background = Color3.fromRGB(24, 24, 28),
    Panel = Color3.fromRGB(32, 32, 38),
    Accent = Color3.fromRGB(90, 120, 255),
    Text = Color3.fromRGB(235, 235, 240),
    SubText = Color3.fromRGB(160, 160, 170),
    Stroke = Color3.fromRGB(50, 50, 58),
    Font = Enum.Font.Gotham,
    FontBold = Enum.Font.GothamBold,
}

----------------------------------------------------------------
-- Helpers
----------------------------------------------------------------
local function new(class, props, children)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        inst[k] = v
    end
    for _, child in ipairs(children or {}) do
        child.Parent = inst
    end
    return inst
end

local function corner(radius)
    return new("UICorner", { CornerRadius = UDim.new(0, radius or 6) })
end

local function stroke(color, thickness)
    return new("UIStroke", {
        Color = color or Theme.Stroke,
        Thickness = thickness or 1,
    })
end

local function tween(inst, props, time)
    TweenService:Create(inst, TweenInfo.new(time or 0.18, Enum.EasingStyle.Quad), props):Play()
end

----------------------------------------------------------------
-- Library
----------------------------------------------------------------
local Hub = {}
Hub.__index = Hub

function Hub:CreateWindow(title)
    local ScreenGui = new("ScreenGui", {
        Name = GUI_NAME,
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = PlayerGui,
    })

    local Main = new("Frame", {
        Name = "Main",
        Size = UDim2.new(0, 340, 0, 420),
        Position = UDim2.new(0.5, -170, 0.5, -210),
        BackgroundColor3 = Theme.Background,
        Parent = ScreenGui,
    }, { corner(10), stroke() })

    local TopBar = new("Frame", {
        Name = "TopBar",
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = Theme.Panel,
        Parent = Main,
    }, { corner(10) })

    -- cover the bottom rounded corners of the topbar so it looks flush
    new("Frame", {
        Size = UDim2.new(1, 0, 0, 10),
        Position = UDim2.new(0, 0, 1, -10),
        BackgroundColor3 = Theme.Panel,
        BorderSizePixel = 0,
        Parent = TopBar,
    })

    new("TextLabel", {
        Text = title or "Hub",
        Font = Theme.FontBold,
        TextSize = 16,
        TextColor3 = Theme.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -20, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = TopBar,
    })

    -- drag support
    do
        local dragging, dragStart, startPos = false, nil, nil
        TopBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = Main.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                Main.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end)
    end

    local Container = new("ScrollingFrame", {
        Name = "Container",
        Size = UDim2.new(1, -16, 1, -52),
        Position = UDim2.new(0, 8, 0, 46),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = Theme.Accent,
        Parent = Main,
    })

    new("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = Container,
    })

    local Window = setmetatable({
        ScreenGui = ScreenGui,
        Main = Main,
        Container = Container,
        _order = 0,
    }, Hub)

    return Window
end

local function nextOrder(self)
    self._order = self._order + 1
    return self._order
end

----------------------------------------------------------------
-- Toggle
----------------------------------------------------------------
function Hub:CreateToggle(text, default, callback)
    default = default or false
    callback = callback or function() end

    local Holder = new("Frame", {
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = Theme.Panel,
        LayoutOrder = nextOrder(self),
        Parent = self.Container,
    }, { corner(8) })

    new("TextLabel", {
        Text = text,
        Font = Theme.Font,
        TextSize = 14,
        TextColor3 = Theme.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -60, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Holder,
    })

    local Switch = new("Frame", {
        Size = UDim2.new(0, 40, 0, 20),
        Position = UDim2.new(1, -50, 0.5, -10),
        BackgroundColor3 = default and Theme.Accent or Theme.Stroke,
        Parent = Holder,
    }, { corner(10) })

    local Knob = new("Frame", {
        Size = UDim2.new(0, 16, 0, 16),
        Position = default and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        Parent = Switch,
    }, { corner(8) })

    local Button = new("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        Parent = Holder,
    })

    local state = default
    local api = {}

    local function set(value)
        state = value
        tween(Switch, { BackgroundColor3 = state and Theme.Accent or Theme.Stroke })
        tween(Knob, { Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8) })
        callback(state)
    end

    Button.MouseButton1Click:Connect(function()
        set(not state)
    end)

    function api:Set(value)
        set(value)
    end
    function api:Get()
        return state
    end

    return api
end

----------------------------------------------------------------
-- Dropdown (single select)
----------------------------------------------------------------
function Hub:CreateDropdown(text, options, default, callback)
    options = options or {}
    callback = callback or function() end

    local Holder = new("Frame", {
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = Theme.Panel,
        ClipsDescendants = true,
        LayoutOrder = nextOrder(self),
        Parent = self.Container,
    }, { corner(8) })

    local Label = new("TextLabel", {
        Text = text,
        Font = Theme.Font,
        TextSize = 14,
        TextColor3 = Theme.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -80, 0, 36),
        Position = UDim2.new(0, 12, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Holder,
    })

    local SelectedLabel = new("TextLabel", {
        Text = default or "Select...",
        Font = Theme.Font,
        TextSize = 13,
        TextColor3 = Theme.SubText,
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 100, 0, 36),
        Position = UDim2.new(1, -128, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = Holder,
    })

    local ToggleButton = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundTransparency = 1,
        Text = "",
        Parent = Holder,
    })

    local List = new("Frame", {
        Position = UDim2.new(0, 0, 0, 36),
        Size = UDim2.new(1, 0, 0, #options * 28 + 6),
        BackgroundTransparency = 1,
        Parent = Holder,
    })

    new("UIListLayout", {
        Padding = UDim.new(0, 2),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = List,
    })

    local open = false
    local selected = default

    local function refreshHeight()
        Holder.Size = UDim2.new(1, 0, 0, open and (36 + #options * 28 + 6) or 36)
    end

    for i, option in ipairs(options) do
        local OptButton = new("TextButton", {
            Size = UDim2.new(1, -16, 0, 26),
            Position = UDim2.new(0, 8, 0, 0),
            BackgroundColor3 = Theme.Background,
            Text = option,
            Font = Theme.Font,
            TextSize = 13,
            TextColor3 = Theme.Text,
            LayoutOrder = i,
            Parent = List,
        }, { corner(6) })

        OptButton.MouseButton1Click:Connect(function()
            selected = option
            SelectedLabel.Text = option
            callback(option)
            open = false
            refreshHeight()
        end)
    end

    ToggleButton.MouseButton1Click:Connect(function()
        open = not open
        refreshHeight()
    end)

    local api = {}
    function api:Get()
        return selected
    end
    function api:Set(option)
        selected = option
        SelectedLabel.Text = option
        callback(option)
    end

    if default then
        callback(default)
    end

    return api
end

----------------------------------------------------------------
-- MultiDropdown (multi select)
----------------------------------------------------------------
function Hub:CreateMultiDropdown(text, options, defaults, callback)
    options = options or {}
    defaults = defaults or {}
    callback = callback or function() end

    local selectedSet = {}
    for _, v in ipairs(defaults) do
        selectedSet[v] = true
    end

    local Holder = new("Frame", {
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = Theme.Panel,
        ClipsDescendants = true,
        LayoutOrder = nextOrder(self),
        Parent = self.Container,
    }, { corner(8) })

    new("TextLabel", {
        Text = text,
        Font = Theme.Font,
        TextSize = 14,
        TextColor3 = Theme.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -80, 0, 36),
        Position = UDim2.new(0, 12, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Holder,
    })

    local SelectedLabel = new("TextLabel", {
        Text = (#defaults > 0) and table.concat(defaults, ", ") or "None",
        Font = Theme.Font,
        TextSize = 12,
        TextColor3 = Theme.SubText,
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 120, 0, 36),
        Position = UDim2.new(1, -148, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Right,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = Holder,
    })

    local ToggleButton = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundTransparency = 1,
        Text = "",
        Parent = Holder,
    })

    local List = new("Frame", {
        Position = UDim2.new(0, 0, 0, 36),
        Size = UDim2.new(1, 0, 0, #options * 28 + 6),
        BackgroundTransparency = 1,
        Parent = Holder,
    })

    new("UIListLayout", {
        Padding = UDim.new(0, 2),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = List,
    })

    local open = false

    local function refreshHeight()
        Holder.Size = UDim2.new(1, 0, 0, open and (36 + #options * 28 + 6) or 36)
    end

    local function refreshSelectedLabel()
        local list = {}
        for _, opt in ipairs(options) do
            if selectedSet[opt] then
                table.insert(list, opt)
            end
        end
        SelectedLabel.Text = (#list > 0) and table.concat(list, ", ") or "None"
        callback(list)
    end

    for i, option in ipairs(options) do
        local OptButton = new("TextButton", {
            Size = UDim2.new(1, -16, 0, 26),
            Position = UDim2.new(0, 8, 0, 0),
            BackgroundColor3 = selectedSet[option] and Theme.Accent or Theme.Background,
            Text = option,
            Font = Theme.Font,
            TextSize = 13,
            TextColor3 = Theme.Text,
            LayoutOrder = i,
            Parent = List,
        }, { corner(6) })

        OptButton.MouseButton1Click:Connect(function()
            selectedSet[option] = not selectedSet[option]
            tween(OptButton, { BackgroundColor3 = selectedSet[option] and Theme.Accent or Theme.Background }, 0.12)
            refreshSelectedLabel()
        end)
    end

    ToggleButton.MouseButton1Click:Connect(function()
        open = not open
        refreshHeight()
    end)

    local api = {}
    function api:Get()
        local list = {}
        for _, opt in ipairs(options) do
            if selectedSet[opt] then
                table.insert(list, opt)
            end
        end
        return list
    end

    if #defaults > 0 then
        callback(defaults)
    end

    return api
end

----------------------------------------------------------------
-- Slider (with linked textbox)
----------------------------------------------------------------
function Hub:CreateSlider(text, min, max, default, callback)
    min = min or 0
    max = max or 100
    default = math.clamp(default or min, min, max)
    callback = callback or function() end

    local Holder = new("Frame", {
        Size = UDim2.new(1, 0, 0, 56),
        BackgroundColor3 = Theme.Panel,
        LayoutOrder = nextOrder(self),
        Parent = self.Container,
    }, { corner(8) })

    new("TextLabel", {
        Text = text,
        Font = Theme.Font,
        TextSize = 14,
        TextColor3 = Theme.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -80, 0, 24),
        Position = UDim2.new(0, 12, 0, 6),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Holder,
    })

    local ValueBox = new("TextBox", {
        Text = tostring(default),
        Font = Theme.Font,
        TextSize = 13,
        TextColor3 = Theme.Text,
        BackgroundColor3 = Theme.Background,
        Size = UDim2.new(0, 56, 0, 22),
        Position = UDim2.new(1, -68, 0, 6),
        ClearTextOnFocus = false,
        Parent = Holder,
    }, { corner(6) })

    local Track = new("Frame", {
        Size = UDim2.new(1, -24, 0, 6),
        Position = UDim2.new(0, 12, 0, 38),
        BackgroundColor3 = Theme.Stroke,
        Parent = Holder,
    }, { corner(3) })

    local Fill = new("Frame", {
        Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = Theme.Accent,
        Parent = Track,
    }, { corner(3) })

    local Knob = new("Frame", {
        Size = UDim2.new(0, 14, 0, 14),
        Position = UDim2.new((default - min) / (max - min), -7, 0.5, -7),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        ZIndex = 2,
        Parent = Track,
    }, { corner(7) })

    local value = default
    local dragging = false

    local function setValue(v, fromTextbox)
        v = math.clamp(v, min, max)
        v = math.floor(v + 0.5)
        value = v
        local alpha = (max > min) and (v - min) / (max - min) or 0
        Fill.Size = UDim2.new(alpha, 0, 1, 0)
        Knob.Position = UDim2.new(alpha, -7, 0.5, -7)
        if not fromTextbox then
            ValueBox.Text = tostring(v)
        end
        callback(v)
    end

    local function updateFromX(xPos)
        local rel = math.clamp((xPos - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
        setValue(min + rel * (max - min))
    end

    Track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromX(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromX(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    ValueBox.FocusLost:Connect(function(enterPressed)
        local num = tonumber(ValueBox.Text)
        if num then
            setValue(num, true)
            ValueBox.Text = tostring(value)
        else
            ValueBox.Text = tostring(value)
        end
    end)

    local api = {}
    function api:Set(v)
        setValue(v)
    end
    function api:Get()
        return value
    end

    return api
end

return Hub
