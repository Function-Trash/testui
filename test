        TextColor3 = Theme.Accent,
        BackgroundTransparency = 1,
        Size = UDim2.new(0.5, -30, 0, 34),
        Position = UDim2.new(0.5, 0, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Right,
        ZIndex = 2,
        Parent = Holder,
    })

    local ListHolder = make("Frame", {
        Position = UDim2.new(0, 0, 0, 34),
        Size = UDim2.new(1, 0, 0, #options * 28),
        BackgroundColor3 = Theme.Section,
        ZIndex = 2,
        Parent = Holder,
    })
    make("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Parent = ListHolder})

    local open = false
    local function setOpen(v)
        open = v
        tween(Holder, {Size = v and UDim2.new(1, -10, 0, 34 + #options * 28) or UDim2.new(1, -10, 0, 34)}, 0.15)
    end

    local function refreshLabel()
        local count = 0
        for _ in pairs(selectedSet) do count += 1 end
        SelectedLabel.Text = count .. " selected"
    end

    local function commit()
        local list = {}
        for _, opt in ipairs(options) do
            if selectedSet[opt] then table.insert(list, opt) end
        end
        settings:Set(key, list)
        callback(list)
    end

    for i, opt in ipairs(options) do
        local OptBtn = make("TextButton", {
            Text = (selectedSet[opt] and "✓ " or "  ") .. tostring(opt),
            Font = Enum.Font.Gotham,
            TextSize = 12,
            TextColor3 = selectedSet[opt] and Theme.Accent or Theme.Text,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 28),
            LayoutOrder = i,
            ZIndex = 2,
            Parent = ListHolder,
        })
        OptBtn.MouseButton1Click:Connect(function()
            selectedSet[opt] = not selectedSet[opt] or nil
            OptBtn.Text = (selectedSet[opt] and "✓ " or "  ") .. tostring(opt)
            OptBtn.TextColor3 = selectedSet[opt] and Theme.Accent or Theme.Text
            refreshLabel()
            commit()
        end)
    end

    Head.MouseButton1Click:Connect(function()
        setOpen(not open)
    end)

    commit()
    return Holder
end

-- KEYBIND (used for things like the UI toggle key)
function TabMethods:AddKeybind(key, default, callback)
    callback = callback or function() end
    local settings = self.Library.Settings
    local current = settings:Get(key, default or "RightControl")

    local Holder = make("Frame", {
        Size = UDim2.new(1, -10, 0, 34),
        BackgroundColor3 = Theme.Element,
        Parent = self.Page,
    })
    corner(Holder, 6)
    stroke(Holder, Theme.Stroke, 1)

    make("TextLabel", {
        Text = key,
        Font = Enum.Font.Gotham,
        TextSize = 13,
        TextColor3 = Theme.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(0.5, -10, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Holder,
    })

    local BindBtn = make("TextButton", {
        Text = current,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextColor3 = Theme.Accent,
        BackgroundColor3 = Theme.Section,
        AutoButtonColor = false,
        Size = UDim2.new(0.4, 0, 0, 24),
        Position = UDim2.new(0.6, 0, 0.5, -12),
        Parent = Holder,
    })
    corner(BindBtn, 4)

    local listening = false
    BindBtn.MouseButton1Click:Connect(function()
        if listening then return end
        listening = true
        BindBtn.Text = "..."
        tween(BindBtn, {BackgroundColor3 = Theme.Accent})

        local conn
        conn = UserInputService.InputBegan:Connect(function(input, gpe)
            if input.UserInputType == Enum.UserInputType.Keyboard then
                current = input.KeyCode.Name
                BindBtn.Text = current
                tween(BindBtn, {BackgroundColor3 = Theme.Section})
                settings:Set(key, current)
                callback(current)
                listening = false
                conn:Disconnect()
            end
        end)
    end)

    callback(current)
    return Holder
end

-- EXIT BUTTON (with Yes/No confirm dialog)
function TabMethods:AddExitButton(text, promptTitle, promptText)
    text = text or "Exit UI"
    promptTitle = promptTitle or "Close UI"
    promptText = promptText or "Are you sure you want to close?"

    local lib = self.Library
    local Btn = make("TextButton", {
        Text = text,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextColor3 = Theme.Text,
        BackgroundColor3 = Color3.fromRGB(190, 60, 60),
        AutoButtonColor = false,
        Size = UDim2.new(1, -10, 0, 34),
        Parent = self.Page,
    })
    corner(Btn, 6)
    stroke(Btn, Theme.Stroke, 1)

    Btn.MouseEnter:Connect(function() tween(Btn, {BackgroundColor3 = Color3.fromRGB(215, 70, 70)}) end)
    Btn.MouseLeave:Connect(function() tween(Btn, {BackgroundColor3 = Color3.fromRGB(190, 60, 60)}) end)

    Btn.MouseButton1Click:Connect(function()
        lib:Confirm(promptTitle, promptText, function()
            lib.ScreenGui:Destroy()
        end, function()
            -- "No" clicked, do nothing, dialog just closes
        end)
    end)

    return Btn
end

return Library
