--[[
    HubUI v2 - Roblox GUI library
    Components: Section, Toggle, Dropdown, MultiDropdown, Slider (with textbox)
    Extras: live theme customization (Accent/Background/Panel/Section colors),
            minimize/close buttons, hover feedback, auto-destroy on re-execute.

    Performance notes:
    - No per-frame polling loops anywhere; everything is event-driven
      (InputBegan/Changed/MouseButton1Click/FocusLost).
    - Theme changes update existing instances in place via a small registry
      instead of destroying and rebuilding any UI.
    - Layout uses UIListLayout + AutomaticSize instead of manual position math,
      so adding/removing elements never requires a manual re-layout pass.

    USAGE:

    local Hub = loadstring(game:HttpGet("..."))()
    local Window = Hub:CreateWindow("My Hub")

    -- quick elements go in an auto-created "General" section:
    Window:CreateToggle("Enable Thing", false, function(state) end)

    -- or make your own named sections:
    local Combat = Window:CreateSection("Combat")
    Combat:CreateToggle("Auto Parry", false, function(state) end)
    Combat:CreateSlider("Reach", 0, 50, 10, function(v) end)

    -- built-in color customization section:
    Window:CreateColorSettingsSection("Settings")
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

----------------------------------------------------------------
-- Destroy any previous instance of this UI before creating a new one
----------------------------------------------------------------
local GUI_NAME = "HubUI"

local existing = PlayerGui:FindFirstChild(GUI_NAME)
if existing then
    existing:Destroy()
end

----------------------------------------------------------------
-- Theme (mutable at runtime via the registry below)
----------------------------------------------------------------
local Theme = {
    Background = Color3.fromRGB(20, 20, 24),
    Panel = Color3.fromRGB(27, 27, 32),
    Section = Color3.fromRGB(32, 32, 38),
    Accent = Color3.fromRGB(90, 120, 255),
    Text = Color3.fromRGB(235, 235, 240),
    SubText = Color3.fromRGB(150, 150, 160),
    Stroke = Color3.fromRGB(45, 45, 52),
    Font = Enum.Font.Gotham,
    FontBold = Enum.Font.GothamBold,
}

-- {Instance, Property, Key} entries; updated in place when a theme color changes.
local Registry = {}

local function Themed(inst, property, key)
    table.insert(Registry, { Instance = inst, Property = property, Key = key })
    inst[property] = Theme[key]
    return inst
end

local function ApplyTheme(key, color)
    Theme[key] = color
    for _, entry in ipairs(Registry) do
        if entry.Key == key and entry.Instance and entry.Instance.Parent then
            if (not entry.Guard) or entry.Guard() then
                entry.Instance[entry.Property] = color
            end
        end
    end
end

----------------------------------------------------------------
-- Helpers
----------------------------------------------------------------
local function new(class, props, children)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        inst[k] = v
    end
    for _, child in ipairs(children or {}) do
        child.Parent = inst
    end
    return inst
end

local function corner(radius)
    return new("UICorner", { CornerRadius = UDim.new(0, radius or 8) })
end

local function strokeInst(thickness)
    local s = new("UIStroke", { Thickness = thickness or 1, Transparency = 0.4 })
    Themed(s, "Color", "Stroke")
    return s
end

local function tween(inst, props, time)
    TweenService:Create(inst, TweenInfo.new(time or 0.16, Enum.EasingStyle.Quad), props):Play()
end

local function lighten(color, amt)
    local h, s, v = color:ToHSV()
    return Color3.fromHSV(h, s, math.clamp(v + amt, 0, 1))
end

local function hoverize(button, key)
    button.MouseEnter:Connect(function()
        tween(button, { BackgroundColor3 = lighten(Theme[key], 0.06) }, 0.12)
    end)
    button.MouseLeave:Connect(function()
        tween(button, { BackgroundColor3 = Theme[key] }, 0.12)
    end)
end

local function hexToColor3(hex)
    hex = hex:gsub("#", ""):gsub("%s", "")
    if #hex ~= 6 then
        return nil
    end
    local r = tonumber(hex:sub(1, 2), 16)
    local g = tonumber(hex:sub(3, 4), 16)
    local b = tonumber(hex:sub(5, 6), 16)
    if not (r and g and b) then
        return nil
    end
    return Color3.fromRGB(r, g, b)
end

