--=========================================================
-- THEME
--=========================================================
local Theme = {
    Background   = Color3.fromRGB(24, 24, 28),
    Section      = Color3.fromRGB(32, 32, 38),
    Element      = Color3.fromRGB(40, 40, 47),
    Accent       = Color3.fromRGB(90, 120, 255),
    Text         = Color3.fromRGB(235, 235, 240),
    SubText      = Color3.fromRGB(160, 160, 170),
    Stroke       = Color3.fromRGB(55, 55, 63),
}

local function tween(obj, props, time)
    time = time or 0.18
    TweenService:Create(obj, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 6)
    c.Parent = parent
    return c
end

local function stroke(parent, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or Theme.Stroke
    s.Thickness = thickness or 1
    s.Parent = parent
    return s
end

local function make(class, props, parent)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        inst[k] = v
    end
    if parent then inst.Parent = parent end
    return inst
end

--=========================================================
-- SETTINGS PERSISTENCE
--=========================================================
local Settings = {}
Settings.__index = Settings

local SETTINGS_FILE = "UILibrarySettings.json"

function Settings.new(filename)
    local self = setmetatable({}, Settings)
    self.FileName = filename or SETTINGS_FILE
    self.Data = {}
    self:Load()
    return self
end

function Settings:Load()
    local ok, result = pcall(function()
        if writefile and readfile and isfile and isfile(self.FileName) then
            local raw = readfile(self.FileName)
            return game:GetService("HttpService"):JSONDecode(raw)
        end
        return nil
    end)
    if ok and result then
        self.Data = result
    else
        self.Data = {}
    end
end

function Settings:Save()
    pcall(function()
        if writefile then
            local raw = game:GetService("HttpService"):JSONEncode(self.Data)
            writefile(self.FileName, raw)
        end
    end)
end

function Settings:Set(key, value)
    self.Data[key] = value
    self:Save()
end

function Settings:Get(key, default)
    if self.Data[key] == nil then
        return default
    end
    return self.Data[key]
end

