    local settings = self.Library.Settings
    local selected = settings:Get(key, default or options[1])

    local Holder = make("Frame", {
        Size = UDim2.new(1, -10, 0, 34),
        BackgroundColor3 = Theme.Element,
        ClipsDescendants = true,
        ZIndex = 2,
        Parent = self.Page,
    })
    corner(Holder, 6)
    stroke(Holder, Theme.Stroke, 1)

    local Head = make("TextButton", {
        Text = "", BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 34),
        ZIndex = 2,
        Parent = Holder,
    })

    make("TextLabel", {
        Text = key,
        Font = Enum.Font.Gotham,
        TextSize = 13,
        TextColor3 = Theme.SubText,
        BackgroundTransparency = 1,
        Size = UDim2.new(0.5, -10, 0, 34),
        Position = UDim2.new(0, 10, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 2,
        Parent = Holder,
    })

    local SelectedLabel = make("TextLabel", {
        Text = tostring(selected),
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextColor3 = Theme.Accent,
        BackgroundTransparency = 1,
        Size = UDim2.new(0.5, -30, 0, 34),
        Position = UDim2.new(0.5, 0, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Right,
        ZIndex = 2,
        Parent = Holder,
    })

    local ListHolder = make("Frame", {
        Position = UDim2.new(0, 0, 0, 34),
        Size = UDim2.new(1, 0, 0, #options * 28),
        BackgroundColor3 = Theme.Section,
        ZIndex = 2,
        Parent = Holder,
    })
    local ListLayout = make("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Parent = ListHolder})

    local open = false
    local function setOpen(v)
        open = v
        tween(Holder, {Size = v and UDim2.new(1, -10, 0, 34 + #options * 28) or UDim2.new(1, -10, 0, 34)}, 0.15)
    end

    for i, opt in ipairs(options) do
        local OptBtn = make("TextButton", {
            Text = tostring(opt),
            Font = Enum.Font.Gotham,
            TextSize = 12,
            TextColor3 = Theme.Text,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 28),
            LayoutOrder = i,
            ZIndex = 2,
            Parent = ListHolder,
        })
        OptBtn.MouseButton1Click:Connect(function()
            selected = opt
            SelectedLabel.Text = tostring(opt)
            settings:Set(key, opt)
            callback(opt)
            setOpen(false)
        end)
    end

    Head.MouseButton1Click:Connect(function()
        setOpen(not open)
    end)

    callback(selected)
    return Holder
end

