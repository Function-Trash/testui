function Library:CreateWindow(title, opts)
    opts = opts or {}

    -- cleanup previous instance if re-executed
    local existing = PlayerGui:FindFirstChild("SimpleUILibrary")
    if existing then existing:Destroy() end

    local self = setmetatable({}, Library)
    self.Settings = Settings.new(opts.SettingsFile)
    self.Tabs = {}

    local ScreenGui = make("ScreenGui", {
        Name = "SimpleUILibrary",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = PlayerGui,
    })
    self.ScreenGui = ScreenGui

    local Main = make("Frame", {
        Name = "Main",
        Size = UDim2.new(0, 520, 0, 380),
        Position = UDim2.new(0.5, -260, 0.5, -190),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        Parent = ScreenGui,
    })
    corner(Main, 10)
    stroke(Main, Theme.Stroke, 1)

    -- Draggable top bar
    local TopBar = make("Frame", {
        Name = "TopBar",
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = Theme.Section,
        BorderSizePixel = 0,
        Parent = Main,
    })
    corner(TopBar, 10)

    local TitleLabel = make("TextLabel", {
        Text = title or "UI Library",
        Font = Enum.Font.GothamBold,
        TextSize = 16,
        TextColor3 = Theme.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -20, 1, 0),
        Position = UDim2.new(0, 14, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = TopBar,
    })

    -- dragging logic
    do
        local dragging, dragStart, startPos
        TopBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = Main.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)
        TopBar.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                if dragging then
                    local delta = input.Position - dragStart
                    Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
                end
            end
        end)
    end

    -- Tab bar (left)
    local TabBar = make("Frame", {
        Name = "TabBar",
        Size = UDim2.new(0, 130, 1, -50),
        Position = UDim2.new(0, 10, 0, 50),
        BackgroundColor3 = Theme.Section,
        BorderSizePixel = 0,
        Parent = Main,
    })
    corner(TabBar, 8)
    local TabList = make("UIListLayout", {
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = TabBar,
    })
    make("UIPadding", {
        PaddingTop = UDim.new(0, 8), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
        Parent = TabBar,
    })

    -- Content area (right)
    local ContentArea = make("Frame", {
        Name = "ContentArea",
        Size = UDim2.new(1, -160, 1, -50),
        Position = UDim2.new(0, 150, 0, 50),
        BackgroundTransparency = 1,
        Parent = Main,
    })

    self.Main = Main
    self.TabBar = TabBar
    self.ContentArea = ContentArea
    self._tabButtons = {}

    -- Notification holder
    local NotifyHolder = make("Frame", {
        Name = "NotifyHolder",
        Size = UDim2.new(0, 280, 1, -20),
        Position = UDim2.new(1, -290, 0, 10),
        BackgroundTransparency = 1,
        Parent = ScreenGui,
    })
    make("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
        VerticalAlignment = Enum.VerticalAlignment.Top,
        Parent = NotifyHolder,
    })
    self.NotifyHolder = NotifyHolder

    -- toggle UI visibility with a configurable keybind (default RightControl)
    self.ToggleKey = Enum.KeyCode[self.Settings:Get("_ToggleKeybind", "RightControl")] or Enum.KeyCode.RightControl
    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == self.ToggleKey then
            Main.Visible = not Main.Visible
        end
    end)

    return self
end

